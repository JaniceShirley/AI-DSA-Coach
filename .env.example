# Application Configuration
APP_NAME="AI DSA Coach"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Defaults to SQLite for easy local development, or set PostgreSQL URL
DATABASE_URL="sqlite:///./dsa_coach.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsa_coach"

# Security Configuration
SECRET_KEY="super-secret-key-change-this-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Future AI Service Configuration (Placeholders)
LLM_PROVIDER="mock" # mock, openai, local_lora
LLM_API_KEY=""
LLM_MODEL_NAME="dsa-coach-v1"
