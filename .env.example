# Django General Settings
SECRET_KEY="django-insecure-change-this-secret-key-in-production-environments"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=dsa_coach
DB_USER=dsa_user
DB_PASSWORD=dsa_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=1440
REFRESH_TOKEN_LIFETIME_DAYS=7

# Future AI Service Configuration
LLM_PROVIDER=mock
LLM_MODEL_NAME=dsa-coach-v1
